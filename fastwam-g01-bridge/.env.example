# FastWAM server (no trailing slash)
FASTWAM_INFER_URL=http://136.114.111.201:8000/infer

# Natural-language instruction passed to /infer
BRIDGE_INSTRUCTION=pick up the cup

# g01_sdk | mock
BRIDGE_ADAPTER=g01_sdk

# move_arm | trajectory_abs_joint
CONTROL_BACKEND=move_arm

# Inference loop rate (Hz)
BRIDGE_RATE_HZ=2.0

# Max per-joint change (rad) per command vs current state (G01 arm_command ~15 deg limit)
MAX_JOINT_STEP_RAD=0.25

# Include JPEG base64 images in observation (disable to save bandwidth)
INCLUDE_IMAGES=true

# Optional image resize before encode (width,height); empty = native
# IMAGE_RESIZE=320,256

# When FastWAM returns 7 floats: duplicate | left_only | right_only
ACTION_7DOF_MODE=duplicate

# Skip camera warmup frames (CosineCamera first frame may be None)
CAMERA_WARMUP_FRAMES=2
